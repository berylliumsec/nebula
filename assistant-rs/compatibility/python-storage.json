  "schema_sql": [
    "CREATE TABLE alembic_version (\n\tversion_num VARCHAR(32) NOT NULL, \n\tCONSTRAINT alembic_version_pkc PRIMARY KEY (version_num)\n)",
    "CREATE TABLE entities (\n\tid VARCHAR(200) NOT NULL, \n\tkind VARCHAR(80) NOT NULL, \n\tengagement_id VARCHAR(200), \n\trevision INTEGER NOT NULL, \n\tpayload JSON NOT NULL, \n\tcreated_at DATETIME NOT NULL, \n\tupdated_at DATETIME NOT NULL, automation_run_id VARCHAR(200), automation_session_id VARCHAR(200), automation_status VARCHAR(40), automation_expires_at DATETIME, chat_session_id VARCHAR(200), \n\tPRIMARY KEY (id)\n)",
    "CREATE TABLE schema_versions (\n\tversion INTEGER NOT NULL, \n\tapplied_at DATETIME NOT NULL, \n\tPRIMARY KEY (version)\n)",
    "CREATE TABLE search_documents (\n\tid VARCHAR(4096) NOT NULL, \n\tproject_id VARCHAR(200), \n\tresource_kind VARCHAR(80) NOT NULL, \n\tresource_id VARCHAR(4096) NOT NULL, \n\trevision INTEGER NOT NULL, \n\tlabel VARCHAR(500) NOT NULL, \n\tdescription VARCHAR(2000) DEFAULT '' NOT NULL, \n\tbreadcrumb VARCHAR(1000) DEFAULT '' NOT NULL, \n\tcontent VARCHAR(8000) DEFAULT '' NOT NULL, \n\tupdated_at DATETIME NOT NULL, \n\tPRIMARY KEY (id)\n)",
    "CREATE TABLE session_projections (\n\tsession_id VARCHAR(200) NOT NULL, \n\trevision BIGINT NOT NULL, \n\tdigest VARCHAR(64) NOT NULL, \n\tPRIMARY KEY (session_id), \n\tFOREIGN KEY(session_id) REFERENCES entities (id) ON DELETE CASCADE\n)",
    "CREATE INDEX ix_entities_automation_run_session ON entities (kind, automation_run_id, automation_session_id)",
    "CREATE INDEX ix_entities_automation_status_expiry ON entities (kind, automation_status, automation_expires_at)",
    "CREATE INDEX ix_entities_engagement_updated ON entities (engagement_id, updated_at)",
    "CREATE INDEX ix_entities_kind ON entities (kind)",
    "CREATE INDEX ix_entities_kind_chat_session_created ON entities (kind, chat_session_id, created_at, id)",
    "CREATE INDEX ix_entities_kind_engagement ON entities (kind, engagement_id)",
    "CREATE INDEX ix_entities_kind_updated ON entities (kind, updated_at)",
    "CREATE INDEX ix_search_documents_label ON search_documents (label)",
    "CREATE INDEX ix_search_documents_project_kind ON search_documents (project_id, resource_kind)",
    "CREATE INDEX ix_search_documents_updated ON search_documents (updated_at)"
  ],
